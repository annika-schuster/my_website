@import url('https://fonts.googleapis.com/css2?family=Source+Sans+3:wght@400;600;700&family=Source+Serif+4:wght@600;700&display=swap');

/* ---------- Fonts ---------- */

body {
  font-family: "Source Sans 3", sans-serif;
  font-size: 1.05rem;
}

h1, h2, h3, h4,
.title {
  font-family: "Source Serif 4", serif;
}

.navbar,
.navbar-brand,
.navbar-title,
.navbar-nav .nav-link {
  font-family: "Source Serif 4", serif !important;
}

/* ---------- Colours (taken from the profile photo: light blue of the dress) ---------- */

:root {
  --accent-light: #bccde3;   /* navbar background */
  --accent: #2b5c8a;         /* links */
  --accent-dark: #1f3a5f;    /* headings, navbar text */
}

.navbar {
  background-color: var(--accent-light) !important;
}

.navbar-brand,
.navbar-title,
.navbar-nav .nav-link {
  color: var(--accent-dark) !important;
}

.navbar-nav .nav-link:hover,
.navbar-nav .nav-link.active {
  color: var(--accent) !important;
}

h1, h2, h3, h4,
.title {
  color: var(--accent-dark);
}

a {
  color: var(--accent);
}

a:hover {
  color: var(--accent-dark);
}

.about-link {
  color: var(--accent-dark) !important;
  border-color: var(--accent-light) !important;
}

.about-link:hover {
  background-color: var(--accent-light);
}

